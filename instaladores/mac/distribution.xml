<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Impera Meta MCP</title>
    <organization>local.impera</organization>
    <welcome file="bemvindo.html" mime-type="text/html"/>
    <conclusion file="concluido.html" mime-type="text/html"/>
    <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="11.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="padrao"/>
    </choices-outline>
    <choice id="padrao" visible="false" title="Impera Meta MCP">
        <pkg-ref id="local.impera.meta-mcp.instalador"/>
    </choice>
    <pkg-ref id="local.impera.meta-mcp.instalador" version="__VERSAO__" onConclusion="none">componente.pkg</pkg-ref>
</installer-gui-script>
