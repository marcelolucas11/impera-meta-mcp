# Ajustes gerais do servidor. Os tokens NÃO ficam aqui: cada cliente tem o seu
# arquivo em clientes/<nome>.env, criado pelo configurar.py.

# Versão da Marketing API.
META_API_VERSION=v26.0

# Pasta raiz dos relatórios. Vazio = relatorios/ ao lado do server.py.
# Cada cliente ganha a própria subpasta: <pasta>/<cliente>/
META_EXPORT_DIR=
